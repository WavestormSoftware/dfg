-- Wavestorm Git v2 for the Defold editor.
-- Entry point: registers the Git panel + file commands and the prefs schema.
-- All git work happens in wavestorm_git/lib/{git,panel,dialogs}.lua.
--
-- Requires the `git` CLI on PATH (checked by Setup / Doctor).
local M = {}

local function core()
	local okk, mod = pcall(require, "wavestorm_git.lib.git")
	if okk then return mod end
	error("wavestorm_git/lib/git.lua missing: " .. tostring(mod))
end

local function dialogs()
	local okk, mod = pcall(require, "wavestorm_git.lib.dialogs")
	if okk then return mod end
	error("wavestorm_git/lib/dialogs.lua missing: " .. tostring(mod))
end

local function prefs_get(key, fallback)
	if type(editor) == "table" and type(editor.prefs) == "table" then
		local okk, v = pcall(editor.prefs.get, key)
		if okk and v ~= nil then return v end
	end
	return fallback
end

local function save_if_pref()
	if prefs_get("wavestorm_git.auto_save", true) then
		pcall(editor.save)
	end
end

local function save_if_pref()
	if prefs_get("wavestorm_git.auto_save", true) then
		pcall(editor.save)
	end
end

local function selection_path(selection)
	if selection == nil then return nil end
	local okk, path = pcall(editor.get, selection, "path")
	if not okk or type(path) ~= "string" or path == "" then return nil end
	-- Editor paths look like "/main/player.script"; git wants "main/player.script".
	if path:sub(1, 1) == "/" then path = path:sub(2) end
	return path
end

local function need_repo(git)
	local res = git.is_repo()
	if res.ok and res.data == true then return true end
	dialogs().error("Git: Not a repository", res)
	return false
end

local function file_active(opts)
	local okk, path = pcall(editor.get, opts.selection, "path")
	return okk and type(path) == "string" and path ~= ""
end

-- ---------------------------------------------------------------------------
-- Command implementations
-- ---------------------------------------------------------------------------

local function cmd_panel()
	require("wavestorm_git.lib.panel").open()
end

local function cmd_quick_commit()
	local git = core()
	if not need_repo(git) then return end
	local message = dialogs().input("Git: Quick Commit", "Commit message:", "", "Commit")
	if message == nil then return end
	if message:match("%S") == nil then
		dialogs().error("Git: Quick Commit", "Write a commit message first.")
		return
	end
	save_if_pref()
	local res = git.add_all()
	if res.ok then res = git.commit(message, false) end
	if res.ok then
		if prefs_get("wavestorm_git.push_after_commit", false) then
			local st = git.status()
			local branch = st.ok and st.data.branch or nil
			local set_upstream = st.ok and st.data.upstream == nil and branch ~= nil
			local pres = git.push(prefs_get("wavestorm_git.default_remote", "origin"), branch, set_upstream)
			if not pres.ok then
				res = { ok = false, kind = pres.kind,
					message = "Commit succeeded, but push failed:\n" .. dialogs().result_text(pres),
					hint = pres.hint }
			else
				res = { ok = true, data = "Committed & pushed." }
			end
		end
	end
	if res.ok then
		dialogs().info("Git: Quick Commit", "Committed:\n\n" .. dialogs().result_text(res))
		print("[wavestorm_git] quick commit: " .. dialogs().result_text(res))
	else
		dialogs().error("Git: Quick Commit", res)
	end
end

local function cmd_doctor()
	local git = core()
	local gui = dialogs()
	local lines = {}

	lines[#lines + 1] = "Editor: " .. tostring(editor.version) .. " on " .. tostring(editor.platform)

	local ver = git.git_version()
	if ver.ok then
		lines[#lines + 1] = "git: " .. ver.data
	else
		lines[#lines + 1] = "git: NOT FOUND on PATH — install git and reload."
	end

	local repo = git.is_repo()
	lines[#lines + 1] = (repo.ok and repo.data == true)
		and "repo: yes (project is a git working tree)"
		or "repo: NO — run 'git init' (button below after closing this dialog)"

	if repo.ok and repo.data then
		local st = git.status()
		if st.ok then
			local stt = st.data
			if stt.head_state == "detached" then
				lines[#lines + 1] = "branch: (detached HEAD)"
			else
				lines[#lines + 1] = "branch: " .. tostring(stt.branch) .. " ("
					.. tostring(stt.head_state) .. ")"
			end
			if stt.upstream then
				lines[#lines + 1] = "upstream: " .. stt.upstream
					.. (stt.ahead and string.format(" (ahead %d / behind %d)", stt.ahead, stt.behind or 0) or "")
			else
				lines[#lines + 1] = "upstream: (none — push with -u once)"
			end
			lines[#lines + 1] = git.summary(stt)
			if stt.oid == "(initial)" then
				lines[#lines + 1] = "note: no commits yet — stage files and commit."
			end
		end

		local rem = git.remotes()
		if rem.ok then
			local n = 0
			for name, url in pairs(rem.data) do
				n = n + 1
				lines[#lines + 1] = "remote '" .. name .. "': " .. url
			end
			if n == 0 then lines[#lines + 1] = "remotes: (none configured)" end
		end

		local cfg = git.user_config()
		if cfg.ok then
			lines[#lines + 1] = "user.name: " .. (cfg.data.name ~= "" and cfg.data.name or "(not set)")
			lines[#lines + 1] = "user.email: " .. (cfg.data.email ~= "" and cfg.data.email or "(not set)")
			if cfg.data.name == "" or cfg.data.email == "" then
				lines[#lines + 1] = ""
				lines[#lines + 1] = "Set identity (terminal):"
				lines[#lines + 1] = "  git config --global user.name \"Your Name\""
				lines[#lines + 1] = "  git config --global user.email \"you@example.com\""
			end
		end

		local v2 = git.supports_v2()
		lines[#lines + 1] = v2.ok and "porcelain v2: supported" or "porcelain v2: NOT supported — please update git."
	end

	lines[#lines + 1] = ""
	lines[#lines + 1] = "Build output /build and /.internal is covered by .gitignore."
	lines[#lines + 1] = "Large binaries: keep them in Git LFS or outside the repo."

	gui.text("Git: Setup / Doctor", table.concat(lines, "\n"))

	if not (repo.ok and repo.data) then
		if ver.ok and gui.confirm("Git: Init repository?",
			"No git repository found in this project. Initialise one now?", "Init") then
			local res = git.exec({ "init" }, { reload = true })
			if res[1] then
				print("[wavestorm_git] " .. tostring(res[2]))
				gui.info("Git: Initialised",
					"Repository created.\nNext steps:\n  git remote add origin <url>\n  Stage files and make an initial commit.")
			else
				gui.error("Git: Init failed", res[3] and res[3].message or "git init failed")
			end
		end
	end
end

-- File-scoped commands -------------------------------------------------------

local function cmd_diff_file(opts)
	local git = core()
	if not need_repo(git) then return end
	local path = selection_path(opts.selection)
	if not path then
		dialogs().error("Git: Diff", "Select a file first.")
		return
	end
	local res = git.diff(path, false)
	if res.ok and res.data == "" then
		res = git.diff(path, true)
		if res.ok and res.data == "" then
			dialogs().info("Git: Diff — " .. path, "No unstaged or staged changes for this file.")
			return
		end
	end
	if res.ok then
		print("[wavestorm_git] diff " .. path)
		dialogs().text("Git: Diff — " .. path, res.data)
	else
		dialogs().error("Git: Diff failed", res)
	end
end

local function cmd_stage_file(opts)
	local git = core()
	if not need_repo(git) then return end
	local path = selection_path(opts.selection)
	if not path then return end
	save_if_pref()
	local res = git.add(path)
	if res.ok then
		print("[wavestorm_git] staged " .. path)
	else
		dialogs().error("Git: Stage failed", res)
	end
end

local function cmd_unstage_file(opts)
	local git = core()
	if not need_repo(git) then return end
	local path = selection_path(opts.selection)
	if not path then return end
	save_if_pref()
	local res = git.unstage(path)
	if res.ok then
		print("[wavestorm_git] unstaged " .. path)
	else
		dialogs().error("Git: Unstage failed", res)
	end
end

local function cmd_discard_file(opts)
	local git = core()
	if not need_repo(git) then return end
	local path = selection_path(opts.selection)
	if not path then return end
	-- Detect untracked to word the dialog correctly.
	local st = git.status()
	local is_untracked = false
	if st.ok then
		for i = 1, #st.data.files do
			local f = st.data.files[i]
			if f.path == path and f.untracked then is_untracked = true end
		end
	end
	local extra = is_untracked and "\n\nThe untracked file will be deleted." or ""
	if not dialogs().confirm("Git: Discard changes?",
		"Discard ALL changes to:\n\n" .. path .. extra .. "\n\nThis cannot be undone in the editor.", "Discard") then
		return
	end
	save_if_pref()
	local res = git.discard(path, is_untracked)
	if res.ok then
		print("[wavestorm_git] discarded " .. path)
	else
		dialogs().error("Git: Discard failed", res)
	end
end

local function cmd_file_history(opts)
	local git = core()
	if not need_repo(git) then return end
	local path = selection_path(opts.selection)
	if not path then return end
	local res = git.log(prefs_get("wavestorm_git.history_count", 25), path)
	if res.ok then
		dialogs().history(res.data, "Git: History — " .. path)
	else
		dialogs().error("Git: History failed", res)
	end
end

local function cmd_blame_file(opts)
	local git = core()
	if not need_repo(git) then return end
	local path = selection_path(opts.selection)
	if not path then return end
	local res = git.blame(path)
	if res.ok then
		print("[wavestorm_git] blame " .. path)
		dialogs().text("Git: Blame — " .. path, res.data)
	else
		dialogs().error("Git: Blame failed", res)
	end
end

local function cmd_history_all()
	local git = core()
	if not need_repo(git) then return end
	local res = git.log(prefs_get("wavestorm_git.history_count", 25), nil)
	if res.ok then
		dialogs().history(res.data)
	else
		dialogs().error("Git: History failed", res)
	end
end

-- ---------------------------------------------------------------------------
-- Registration
-- ---------------------------------------------------------------------------

function M.get_prefs_schema()
	return {
		["wavestorm_git.default_remote"] = editor.prefs.schema.string({ default = "origin" }),
		["wavestorm_git.auto_save"] = editor.prefs.schema.boolean({ default = true }),
		["wavestorm_git.push_after_commit"] = editor.prefs.schema.boolean({ default = false }),
		["wavestorm_git.pull_ff_only"] = editor.prefs.schema.boolean({ default = false }),
		["wavestorm_git.confirm_discard"] = editor.prefs.schema.boolean({ default = true }),
		["wavestorm_git.auto_fetch"] = editor.prefs.schema.boolean({ default = true }),
		["wavestorm_git.auto_fetch_minutes"] = editor.prefs.schema.integer({ default = 5 }),
		["wavestorm_git.history_count"] = editor.prefs.schema.integer({ default = 25 }),
	}
end

function M.get_commands()
	return {
		{
			label = "Git Panel",
			locations = { "Project" },
			run = cmd_panel,
		},
		{
			label = "Git: Quick Commit...",
			locations = { "Project" },
			run = cmd_quick_commit,
		},
		{
			label = "Git: History...",
			locations = { "Project" },
			run = cmd_history_all,
		},
		{
			label = "Git: Setup / Doctor...",
			locations = { "Project" },
			run = cmd_doctor,
		},
		{
			label = "Git: Diff File",
			locations = { "Assets", "Code", "Outline" },
			query = { selection = { type = "resource", cardinality = "one" } },
			active = file_active,
			run = cmd_diff_file,
		},
		{
			label = "Git: Stage File",
			locations = { "Assets", "Code", "Outline" },
			query = { selection = { type = "resource", cardinality = "one" } },
			active = file_active,
			run = cmd_stage_file,
		},
		{
			label = "Git: Unstage File",
			locations = { "Assets", "Code", "Outline" },
			query = { selection = { type = "resource", cardinality = "one" } },
			active = file_active,
			run = cmd_unstage_file,
		},
		{
			label = "Git: Discard File Changes...",
			locations = { "Assets", "Code", "Outline" },
			query = { selection = { type = "resource", cardinality = "one" } },
			active = file_active,
			run = cmd_discard_file,
		},
		{
			label = "Git: History for File",
			locations = { "Assets", "Code", "Outline" },
			query = { selection = { type = "resource", cardinality = "one" } },
			active = file_active,
			run = cmd_file_history,
		},
		{
			label = "Git: Blame File",
			locations = { "Assets", "Code" },
			query = { selection = { type = "resource", cardinality = "one" } },
			active = function(opts)
				if not file_active(opts) then return false end
				local _, path = pcall(editor.get, opts.selection, "path")
				return type(path) == "string" and path:match("%.lua$") ~= nil
			end,
			run = cmd_blame_file,
		},
	}
end

return M
